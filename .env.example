# ==========================================================
# RACEBET CONTROL — variables d'environnement
# Copiez ce fichier en .env.local (local) et renseignez les
# mêmes variables dans Vercel > Settings > Environment Variables.
# Ne commitez JAMAIS de vraies valeurs.
# ==========================================================

# --- Base de données (obligatoire en production) ---
# Chaîne de connexion Neon (onglet "Connection string", option "Pooled connection").
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/NOM_BASE?sslmode=require
DATABASE_URL=

# --- Développement local sans Neon (facultatif) ---
# "pglite" = PostgreSQL embarqué stocké dans ./.pglite (dev local uniquement, refusé en production).
# Laisser vide pour utiliser DATABASE_URL.
DATABASE_DRIVER=

# --- Sauvegarde automatique quotidienne (facultatif) ---
# Secret de la tâche planifiée Vercel (chaîne aléatoire longue, ex. 48 caractères).
# Vercel l'envoie automatiquement dans l'en-tête Authorization du cron.
CRON_SECRET=

# Stockage Cloudflare R2 (bucket PRIVÉ)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Nombre de jours de conservation des sauvegardes (défaut : 30)
BACKUP_RETENTION_DAYS=30
